{
  "name": "agent-canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fix-pty-helper.js",
    "predev": "node scripts/build-shm.js --if-enabled",
    "prestart": "node scripts/build-shm.js --if-enabled",
    "pretest": "node scripts/build-shm.js --if-enabled",
    "dev": "concurrently -k \"node server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "build:shm": "node scripts/build-shm.js",
    "test:shm": "npm run build:shm && node --test shared/canvas-memory.test.js server/canvas-memory.test.js server/canvas-notify.test.js server/canvas-messages.test.js server/canvas-telemetry.test.js",
    "test:shm:pi": "npm run build:shm && node scripts/tests/pi-shm-smoke.mjs && node scripts/tests/pi-messages-smoke.mjs",
    "start": "node server/index.js",
    "tailscale:setup": "node scripts/tailscale-setup.js",
    "test": "node --test",
    "test:views:browser": "node scripts/tests/card-views-browser.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.1",
    "file-type": "^21.3.4",
    "jsxgraph": "1.14.1",
    "katex": "^0.19.0",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "node-gyp": "13.1.0",
    "vite": "7.3.7"
  },
  "overrides": {
    "katex": "$katex"
  }
}
